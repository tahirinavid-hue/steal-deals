# ── Required: Upstash Redis (state management) ────────────────────────────────
UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_TOKEN_HERE

# ── Required: Email delivery via Resend ──────────────────────────────────────
RESEND_API_KEY=re_YOUR_KEY_HERE
ALERT_RECIPIENT=tahirinavid@gmail.com
SENDER_EMAIL=onboarding@resend.dev  # Resend sandbox — works immediately, no domain needed.
                                    # For production, replace with a verified domain address.

# ── Required: Gemini API (Modules B and C only) ───────────────────────────────
GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE

# ── Optional: ScrapingBee (anti-bot fallback) ────────────────────────────────
SCRAPINGBEE_API_KEY=YOUR_SCRAPINGBEE_KEY_HERE

# ── Optional: Module A threshold overrides ───────────────────────────────────
SNOWBLOWER_THRESHOLD=1600       # Alert if price <= this
SNOWBLOWER_MSRP=1999            # Used to compute steal-discount %
SNOWBLOWER_STEAL_PCT=20         # Alert if price is >= this % below MSRP

# ── Optional: Module B threshold override ────────────────────────────────────
EV_LEASE_THRESHOLD=650          # Alert if true $0-down monthly < this

# ── Optional: Module C threshold overrides ───────────────────────────────────
SOLAR_PPW_THRESHOLD=2.00        # Alert if gross $/W < this
SOLAR_PPA_CEILING=0.12          # Alert if PPA rate < this $/kWh
SOLAR_ESCALATOR_MAX=2.9         # Reject PPAs with escalator >= this %
